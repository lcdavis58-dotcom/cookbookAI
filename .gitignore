# Contains the Pi's SSH password, never commit
.vscode/sftp.json

# Notes and diagnostic output that quote the cookbooks themselves. They
# stay local so the published repo never hosts other people's book text.
BOOK_FORMATS.md
empty_trace.txt
empty_next.txt
recipe_index.json

# Quick throwaway checks and their output, often built from real book
# text, so everything here stays local except the README
testing/one_off/*
!testing/one_off/README.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Data that lives outside app/ on the Pi, ignored here in case a copy
# ever ends up in this folder
chroma_db/
*.pdf

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
